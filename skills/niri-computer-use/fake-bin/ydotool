#!/usr/bin/env node
/**
 * Fake `ydotool` for tests. Records argv exactly — this is the assertion point
 * for "no shell interpolation". Env: FAKE_YDO_EXIT, FAKE_YDO_SLEEP_MS.
 */
import { appendFileSync } from "node:fs";

const argv = process.argv.slice(2);
const log = process.env.FAKE_LOG;
if (log) appendFileSync(log, JSON.stringify({ tool: "ydotool", argv }) + "\n");

const sleepMs = Number(process.env.FAKE_YDO_SLEEP_MS || 0);
if (sleepMs > 0) await new Promise((r) => setTimeout(r, sleepMs));

process.exit(Number(process.env.FAKE_YDO_EXIT || 0));